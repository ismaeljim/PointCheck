-- -----------------------------------------------------
-- Table `pointcheck_db`.`users`
-- -----------------------------------------------------
CREATE TABLE IF NOT EXISTS `pointcheck_db`.`users` (
  `active` BIT(1) NOT NULL DEFAULT b'1',
